%--- tcolorbox for margin notes
\usepackage{tcolorbox}
\tcbuselibrary{skins}
\tcbuselibrary{breakable}
\newcommand{\sidenote}[1]{%
  \marginpar{%
    \vspace{1em}%
    \begin{tcolorbox}[
        enhanced,
        colback=red!10,
        boxrule=0pt,
        sharp corners,
        left=1pt,
        right=1pt,
        top=1pt,
        bottom=1pt,
        width=\marginparwidth,
        boxsep=0pt
      ]
      \footnotesize #1
    \end{tcolorbox}
  }%
}

%--- innote (boxed note with title)
\newcommand{\innote}[2]{%
  \noindent\fbox{\begin{minipage}{\dimexpr\textwidth-2\fboxsep-2\fboxrule\relax}%
        \raggedright\textbf{#1}\quad #2\par
        \end{minipage}}%
}

