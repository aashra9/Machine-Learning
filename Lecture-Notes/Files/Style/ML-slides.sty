%--- Commands

%--- Different types of equalities 
\newcommand{\defn}{\overset{\mathrm{def}}{=}}
%--- should be read "_____defined by_____" or "______defined as______"
\newcommand{\givn}{\overset{\text{by}}{=}} 
%--- should be read "_____given by_______"
\newcommand{\letn}{\overset{\text{be}}{=}} 
%--- should be read "Let  ______ be __________"
\newcommand{\setn}{\overset{\text{set}}{=}}
%--- should be read "set _______ to be _______"
\newcommand{\detn}{\overset{\text{den}}{=}} 
%--- should be read "Let _______ denote _______"







