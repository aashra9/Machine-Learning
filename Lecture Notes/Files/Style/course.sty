%--- The code below is going to make section headings clickable and hyperlinked to the place where they occur in table of contents. This is taken from here: https://tex.stackexchange.com/questions/251904/hyperlinks-from-chapter-and-section-headings-back-to-the-table-of-contents and is the work of John Kormylo
\makeatletter
\let\hyperchapter\chapter
\def\chapter{\@ifstar\starchapter\mychapter}
\def\starchapter{\hyperchapter*}
\newcommand{\mychapter}[2][\@empty]% #1=optional (toc and top of page), #2=title
{\ifx#1\@empty \hyperchapter[#2]{\hyperlink{toc.\@currentHref}{#2}}
 \else \hyperchapter[#1]{\hyperlink{toc.\@currentHref}{#2}}
 \fi}

\let\hypersection\section
\def\section{\@ifstar\starsection\mysection}
\def\starsection{\hypersection*}
\newcommand{\mysection}[2][\@empty]% #1=optional (toc), #2=title
{\ifx#1\@empty \hypersection[#2]{\hyperlink{toc.\@currentHref}{#2}}
 \else \hypersection[#1]{\hyperlink{toc.\@currentHref}{#2}}
 \fi}

\let\hypersubsection\subsection
\def\subsection{\@ifstar\starsubsection\mysubsection}
\def\starsubsection{\hypersubsection*}
\newcommand{\mysubsection}[2][\@empty]% #1=optional (toc), #2=title
{\ifx#1\@empty \hypersubsection[#2]{\hyperlink{toc.\@currentHref}{#2}}
 \else \hypersubsection[#1]{\hyperlink{toc.\@currentHref}{#2}}
 \fi}
\makeatother
