%--- Defining tetra symbol for K4
\newcommand{\tetra}{
{\begin{tikzpicture}[scale=0.035,tempstyle/.style={ inner sep=0pt}]
		\node [style=tempstyle] (0) at (0, 7.25) {};
		\node [style=tempstyle] (1) at (-3.25, 1) {};
		\node [style=tempstyle] (2) at (3.25, 1) {};
		\node [style=tempstyle] (3) at (0, 3.25) {};
		\draw (0.center) to (1.center);
		\draw (1.center) to (2.center);
		\draw (0.center) to (2.center);
		\draw (1.center) to (3.center);
		\draw (0.center) to (3.center);
		\draw (3.center) to (2.center);
\end{tikzpicture}}
}

